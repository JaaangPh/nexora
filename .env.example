# Nexora Technologies Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET=nexora_production_jwt_secret_2025_secure_key_change_in_prod

# JWT Session Lifespan
JWT_EXPIRES_IN=7d

# Admin portal credentials (backend only; never use a VITE_ prefix)
ADMIN_EMAIL=admin@stepora.xyz
ADMIN_PASSWORD=
# Generate a unique random secret of at least 32 characters. Keep it stable to decrypt the saved authenticator key.
ADMIN_AUTH_SECRET=

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://localhost,capacitor://localhost

# Database Type
DB_TYPE=firebase

# Firebase Cloud Firestore Credentials
FIREBASE_PROJECT_ID=nexora-d0290
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@nexora-d0290.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram signup notifications (backend only; never use a VITE_ prefix)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Frontend API Base URL for Mobile Android APK
# For Android Emulator: http://10.0.2.2:5000
# For Physical Device: http://<YOUR_LAN_IP>:5000
# For Production Deployed Web & Mobile: https://api.yourdomain.com
VITE_API_BASE_URL=

# TurboPay merchant integration (configure on the backend only; never add to VITE_ variables)
# Rotate the previously exposed key with TurboPay, then set the replacement here/deployment secrets.
TURBOPAY_ENABLED=false
TURBOPAY_API_URL=https://merchant.turbopay.ph
TURBOPAY_MERCHANT_ID=
TURBOPAY_MERCHANT_KEY=
# Public HTTPS URL routed to POST /api/payments/turbopay/callback
TURBOPAY_CALLBACK_URL=https://api.example.com/api/payments/turbopay/callback
# Public HTTPS URL TurboPay redirects to after the payment flow
TURBOPAY_RETURN_URL=https://example.com/
