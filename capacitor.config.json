{
  "appId": "com.nexora.technologies",
  "appName": "Nexora Technologies",
  "webDir": "dist",
  "server": {
    "url": "https://nexora-rust-nine.vercel.app",
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#142B5B",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#142B5B"
    }
  }
}
