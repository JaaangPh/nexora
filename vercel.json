{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/images/**"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://www.stepm.fun/",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://www.stepm.fun/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
