{
  "name": "nexora",
  "version": "1.0.0",
  "type": "module",
  "description": "Nexora Technologies Secure Access Application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "client": "vite --port 3000",
    "server": "tsx server/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug && cd .. && npm run copy:apk",
    "copy:apk": "node -e \"const fs = require('fs'); fs.mkdirSync('public/downloads', {recursive:true}); const src = fs.existsSync('android/app/build/outputs/apk/release/app-release-unsigned.apk') ? 'android/app/build/outputs/apk/release/app-release-unsigned.apk' : 'android/app/build/outputs/apk/debug/app-debug.apk'; fs.copyFileSync(src, 'public/downloads/nexora-technologies.apk'); console.log('APK copied to public/downloads/nexora-technologies.apk');\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/geolocation": "^8.2.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
